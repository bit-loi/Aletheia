{
  "manifest_version": 3,
  "name": "Aletheia",
  "version": "0.1.0",
  "description": "AI Powered Real Time Fact Checking for News Videos and Web Articles",
  "permissions": [
    "storage",
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "https://aletheia-proxy.rizkymirza18.workers.dev/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.tavily.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/tokens.js",
        "content/styles.js",
        "content/extractor.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
