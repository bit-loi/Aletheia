# Aletheia Environment Configuration
# Copy this file to .env for local reference (never commit .env with real keys to git)

# NVIDIA NIM API Key (minimaxai/minimax-m3)
NVIDIA_API_KEY=nvapi-your-key-here

# Tavily Web Search API Key
TAVILY_API_KEY=tvly-your-key-here

# Deepgram Speech-to-Text API Key
DEEPGRAM_API_KEY=dg-your-key-here
